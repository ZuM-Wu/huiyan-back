{
  "name": "file_download",
  "title": "文件下载",
  "version": "2.0.0",
  "description": "文件下载插件：管理员按文件夹整理并上传文件、控制可见范围，农户在农户端浏览并下载可见文件",
  "author": "HuiYan Team",
  "module": "addon",
  "owner_id": "file_download",
  "surface": "admin",
  "enabled": true,
  "default_order": 100,
  "compatible_app_versions": [">=4.0.0"],
  "dependencies": [],
  "conflicts": [],
  "permissions": ["file_download:list"],
  "capabilities": ["file.download"],
  "pages": [
    {"page_key": "plugin_file_download", "surface": "admin", "route": "/plugin/file_download/file_download", "template": "file_download.html", "permission": "file_download:list"},
    {"page_key": "plugin_file_download_front", "surface": "farmer", "route": "/plugin/file_download/file_download_index", "template": "file_download_index.html", "permission": "file_download:list"}
  ],
  "resources": [],
  "tasks": [],
  "events": ["file_download.downloaded"],
  "health": {"check": "plugin.file_download"},
  "config": {
    "file_download.max_size": "50",
    "file_download.extensions": "pdf,doc,docx,xls,xlsx,ppt,pptx,txt,csv,zip,rar,7z,jpg,jpeg,png,mp4"
  }
}
