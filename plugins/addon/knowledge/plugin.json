{
  "name": "knowledge",
  "title": "农业知识库",
  "version": "1.0.2",
  "description": "农业知识库插件：管理员维护二级分类与知识条目（发生原因/解决方案/典型图片），农户在农户端浏览并提交勘误",
  "author": "HuiYan Team",
  "module": "addon",
  "owner_id": "knowledge",
  "surface": "admin",
  "enabled": true,
  "default_order": 100,
  "compatible_app_versions": [">=3.4.0"],
  "dependencies": [],
  "conflicts": [],
  "permissions": ["knowledge:list", "knowledge:correction"],
  "capabilities": ["knowledge.base"],
  "pages": [
    {"page_key": "plugin_knowledge", "surface": "admin", "route": "/admin/plugin/knowledge/knowledge", "template": "knowledge.html", "permission": "knowledge:list", "scripts": ["knowledge.js"]},
    {"page_key": "plugin_knowledge_corrections", "surface": "admin", "route": "/admin/plugin/knowledge/knowledge_corrections", "template": "knowledge_corrections.html", "permission": "knowledge:correction", "scripts": ["knowledge_corrections.js"]},
    {"page_key": "plugin_knowledge_front", "surface": "farmer", "route": "/farmer/plugin/knowledge/knowledge_index", "template": "knowledge_index.html", "permission": "knowledge:list"}
  ],
  "resources": ["static/knowledge.js", "static/knowledge_corrections.js"],
  "tasks": [],
  "events": [],
  "health": {"check": "plugin.knowledge"},
  "database_schema": {"version": 1, "tables": [{"name": "hy_plugin_knowledge_category", "columns": ["id", "parent_id", "name", "sort_order", "status", "create_time", "update_time"], "indexes": [{"name": "PRIMARY", "columns": ["id"], "unique": true}, {"name": "idx_parent", "columns": ["parent_id"], "unique": false}]}, {"name": "hy_plugin_knowledge_entry", "columns": ["id", "title", "category_id", "crop", "summary", "cause", "solution", "images", "view_count", "sort_order", "admin_id", "create_time", "update_time"], "indexes": [{"name": "PRIMARY", "columns": ["id"], "unique": true}, {"name": "idx_category", "columns": ["category_id"], "unique": false}]}, {"name": "hy_plugin_knowledge_correction", "columns": ["id", "knowledge_id", "farmer_id", "content", "status", "admin_note", "admin_id", "create_time", "handle_time"], "indexes": [{"name": "PRIMARY", "columns": ["id"], "unique": true}, {"name": "idx_knowledge", "columns": ["knowledge_id"], "unique": false}, {"name": "idx_status", "columns": ["status"], "unique": false}]}]},
  "config": {
    "knowledge.allow_correction": "1",
    "knowledge.list_page_size": "10"
  }
}
